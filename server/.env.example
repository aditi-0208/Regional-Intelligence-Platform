# Copy to .env and adjust. .env is gitignored — never commit it.

# true  = serve generated mock data, no database needed
# false = query Azure SQL (requires DBA grant + `az login`)
USE_MOCK=true

AZURE_SQL_SERVER=mumasotrproddbs.database.windows.net
AZURE_SQL_DB=mumasotrproddb

# No user/password: SQL authentication is disabled on this server.
# Locally the app authenticates via your `az login` session.
# In Azure it uses the App Service Managed Identity.

PORT=4000
FRONTEND_URL=http://localhost:3000

CACHE_TTL_MINUTES=60
